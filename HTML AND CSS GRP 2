CSS.

.header-content {
    display: flex;
    align-items: center;
    justify-content: space-between; /* pushes logo to the right */
    padding: 0 20px;
}

header h1 {
    color: #ffd60a;
    margin: 0;
    corner-end-start-shape: initial;
}

/* LOGO ON RIGHT */
.logo {
    width: 80px;   /* adjust size here */
    height: 80px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid #ffd60a;
    background-color: white;
}



body {
    font-family: Arial, sans-serif;
    margin: 0;
    background-color: #fffbea; /* soft yellow background */
}

/* HEADER */
header {
    background-color: #000; /* black */
    color: #ffd60a; /* bright yellow */
    padding: 20px;
    text-align: center;
    border-bottom: 5px solid #ffd60a;
}

/* NAVBAR */
nav {
    background-color: #ffd60a; /* yellow */
    padding: 12px;
    text-align: center;
}

nav a {
    color: #000; /* black text */
    margin: 0 15px;
    text-decoration: none;
    font-weight: bold;
    padding: 6px 10px;
    border-radius: 5px;
}

nav a:hover {
    background-color: #000;
    color: #ffd60a;
}

/* CONTAINER */
.container {
    padding: 20px;
    text-align: center;
}

/* IMAGE GALLERY */
.image-gallery {
    display: flex;
    gap: 15px;
    margin-bottom: 25px;
    flex-wrap: wrap;
    justify-content: center;
}

.image-gallery img {
    width: 300px;
    border-radius: 12px;
    border: 4px solid #ffd60a;
    box-shadow: 0 6px 12px rgba(0,0,0,0.3);
}

.logo {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 4px solid #ffd60a;
    box-shadow: 0 0 10px rgba(255, 214, 10, 0.7);
}
/* CARDS */
.card {
    background: #000;
    color: #ffd60a;
    padding: 20px;
    margin: 15px auto;
    width: 260px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    transition: transform 0.3s;
}

.card:hover {
    transform: scale(1.05);
}

/* BUTTON */
button {
    padding: 12px 25px;
    background-color: #ffd60a;
    color: #000;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
    margin-top: 15px;
}

button:hover {
    background-color: #000;
    color: #ffd60a;
}

/* FOOTER */
footer {
    background-color: #000;
    color: #ffd60a;
    text-align: center;
    padding: 12px;
    margin-top: 20px;
    border-top: 4px solid #ffd60a;
}


body {
    font-family: Arial, sans-serif;
    margin: 0;
    background-color: #796705;
    color: #333;
}

/* Header */
header {
    background-color: #2c3e50;
    color: white;
    padding: 15px;
    text-align: center;
}

/* Navigation */
nav {
    background-color: #0b0f14;
    padding: 10px;
    text-align: center;
}

nav a {
    color: white;
    margin: 15px;
    text-decoration: none;
    font-weight: bold;
}

nav a:hover {
    color: #f1c40f;
}

/* Container */
.container {
    padding: 30px;
    text-align: center;
}

/* Buttons */
button {
    background-color: #3498db;
    color: rgb(209, 231, 12);
    border: none;
    padding: 10px 20px;
    margin: 10px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 16px;
}

button:hover {
    background-color: #2980b9;
}

/* Cards */
.card {
    background: rgb(36, 3, 3);
    padding: 20px;
    margin: 15px;
    display: inline-block;
    width: 250px;
    border-radius: 10px;
    box-shadow: 0px 4px 8px rgba(0,0,0,0.2);
}

/* Forms */
input, select {
    padding: 10px;
    margin: 10px;
    width: 250px;
}

/* Table */
table {
    margin: auto;
    border-collapse: collapse;
    width: 80%;
    background: white;
}

table, th, td {
    border: 1px solid #ccc;
}

th, td {
    padding: 10px;
}

/* Footer */
footer {
    background-color: #2c3e50;
    color: white;
    text-align: center;
    padding: 10px;
    margin-top: 30px;
}



